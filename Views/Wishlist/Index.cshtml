@model IReadOnlyList<WishlistItem>
@{
    ViewData["Title"] = "Wishlist";
}
<div class="container py-4">
    <h1 class="h3 mb-4">Wishlist</h1>
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-6 col-md-3">
                <partial name="_ProductCard" model="item.Product" />
                <form asp-action="Remove" method="post" class="mt-2">
                    <input type="hidden" name="productId" value="@item.ProductId" />
                    <button class="btn btn-outline-danger btn-sm w-100">Remove</button>
                </form>
            </div>
        }
    </div>
</div>
