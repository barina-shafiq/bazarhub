@model Product
@{
    var image = Model.Images.OrderByDescending(i => i.IsPrimary).FirstOrDefault()?.ImagePath ?? "/uploads/sample-product.svg";
    var rating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
}
<div class="card product-card h-100">
    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
        <img src="@image" class="card-img-top product-image" alt="@Model.Name" />
    </a>
    <div class="card-body d-flex flex-column">
        <div class="small text-muted">@Model.Brand</div>
        <h3 class="h6 product-title">@Model.Name</h3>
        <div class="small text-warning mb-1">@rating.ToString("0.0") ★</div>
        <div class="fw-bold text-danger">Rs @Model.EffectivePrice.ToString("N0")</div>
        @if (Model.DiscountPrice.HasValue)
        {
            <div class="small text-muted text-decoration-line-through">Rs @Model.Price.ToString("N0")</div>
        }
        <div class="mt-auto d-flex gap-2 pt-3">
            <form asp-area="" asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button class="btn btn-sm btn-warning w-100">Add</button>
            </form>
            <form asp-area="" asp-controller="Wishlist" asp-action="Toggle" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-secondary">♡</button>
            </form>
        </div>
    </div>
</div>
