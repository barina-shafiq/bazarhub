@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}
<div class="container py-4">
    <h1 class="h3 mb-4">Checkout</h1>
    <form method="post" class="row g-4">
        <div class="col-lg-7">
            <div class="checkout-panel">
                <h2 class="h5">Shipping address</h2>
                <input class="form-control mb-3" asp-for="FullName" placeholder="Full name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
                <input class="form-control mb-3" asp-for="Phone" placeholder="Phone" />
                <input class="form-control mb-3" asp-for="City" placeholder="City" />
                <textarea class="form-control mb-3" asp-for="StreetAddress" placeholder="Street address"></textarea>
                <h2 class="h5 mt-4">Payment method</h2>
                <select class="form-select" asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="summary-box">
                <h2 class="h5">Order summary</h2>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="d-flex justify-content-between small py-1">
                        <span>@item.Product?.Name x @item.Quantity</span>
                        <strong>Rs @(((item.Product?.EffectivePrice ?? 0) * item.Quantity).ToString("N0"))</strong>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between"><span>Total</span><strong>Rs @Model.Cart.Total.ToString("N0")</strong></div>
                <button class="btn btn-warning w-100 mt-3">Place order</button>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
