@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-wrap">
    <form method="post" class="auth-card">
        <h1 class="h3 mb-3">Login</h1>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input class="form-control mb-3" asp-for="Email" placeholder="Email" />
        <input class="form-control mb-3" asp-for="Password" placeholder="Password" />
        <label class="form-check mb-3">
            <input class="form-check-input" asp-for="RememberMe" /> Remember me
        </label>
        <button class="btn btn-warning w-100">Login</button>
        <a class="d-block mt-3" asp-action="Register">Create an account</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
